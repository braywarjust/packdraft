# Copy to .env.local and fill in what you have. Restart the app after changing it.

# Folder of slab photos (defaults to ~/NBA_Slabs_webp)
# SLABS_DIR=/Users/you/NBA_Slabs_webp

# Real market values from eBay (free): developer.ebay.com > Application Keys > Production keyset
# EBAY_CLIENT_ID=your-app-id
# EBAY_CLIENT_SECRET=your-cert-id

# PSA population counts (free, 100 lookups/day): psacard.com/publicapi
# PSA_API_TOKEN=your-token

# GIF search in league chat (free): developers.giphy.com
# GIPHY_API_KEY=your-key
