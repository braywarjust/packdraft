# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
data/

# iCloud-excluded copies
/node_modules.nosync
/.next.nosync
/data.nosync
/.git.nosync
!.env.local.example

# Blender working files (wraps are rebuilt by scripts/pack-renders/build-wraps.mjs)
/blender/pack-wraps/
*_backup.blend
/blender/slab-back/
/blender/mega-case/
/blender/mini-crate/*.png
!/blender/mini-crate/mini-crate-uv-guide*.png
/exports/

# build check output and the live data folder (database, uploads, session secret) never go in git
/.next-*.nosync
/data.nosync
*.db
*.db-wal
*.db-shm
